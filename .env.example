# Copia este archivo a ".env" (mismo directorio) y completa los valores
# reales. ".env" ya esta en .gitignore: nunca se commitea.

DB_NAME=ranking_db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=cambia-esta-clave
# Vhost del broker (debe coincidir con el resto de servicios).
RABBITMQ_VHOST=/
# Clave de dead-letter exclusiva de Ranking. Vacio conserva la topologia actual;
# en un broker nuevo usar ranking.resultado.registrado.queue.dlq y no cambiarla despues.
RANKING_DLX_ROUTING_KEY=

# Origenes permitidos por CORS, separados por coma (sin espacios).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200
# En produccion agregar el origen del front, p. ej. https://fabetabilo.github.io

# Nivel de log de la app en produccion (local puede subirlo a DEBUG si hace falta).
LOG_LEVEL_RANKING=INFO

# Imagen a usar (la publica el pipeline de CI/CD en cada push a main, si se agrega).
# En local con "docker compose up --build" este valor no se usa.
IMAGE=ghcr.io/alvmaltrain/api-athenet-ranking:latest
